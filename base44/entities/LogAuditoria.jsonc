{
  "name": "LogAuditoria",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do tenant"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou a a\u00e7\u00e3o"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "acao": {
      "type": "string",
      "enum": [
        "Criar",
        "Atualizar",
        "Excluir",
        "Login",
        "Logout",
        "Votar",
        "Check-in"
      ],
      "description": "Tipo de a\u00e7\u00e3o realizada"
    },
    "entidade_afetada": {
      "type": "string",
      "description": "Nome da entidade afetada pela a\u00e7\u00e3o"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "detalhes": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da a\u00e7\u00e3o"
    },
    "ip_address": {
      "type": "string",
      "description": "Endere\u00e7o IP do usu\u00e1rio"
    },
    "user_agent": {
      "type": "string",
      "description": "User agent do navegador"
    }
  },
  "required": [
    "tenant_id",
    "acao"
  ]
}