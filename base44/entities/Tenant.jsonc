{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da organiza\u00e7\u00e3o"
    },
    "tipo_organizacao": {
      "type": "string",
      "enum": [
        "Condom\u00ednio",
        "Igreja",
        "Empresa",
        "Associa\u00e7\u00e3o",
        "Cooperativa",
        "Sindicato",
        "Escola/Institui\u00e7\u00e3o Educacional",
        "Clube/Sociedade Recreativa",
        "Outro"
      ],
      "description": "Tipo da organiza\u00e7\u00e3o"
    },
    "cnpj_cpf": {
      "type": "string",
      "description": "CNPJ ou CPF da organiza\u00e7\u00e3o (criptografado)"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo da organiza\u00e7\u00e3o"
    },
    "plano_ativo": {
      "type": "string",
      "description": "ID do plano ativo"
    },
    "status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "canceled",
        "past_due",
        "trial_canceled"
      ],
      "default": "trialing",
      "description": "Status da assinatura"
    },
    "data_inicio_trial": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio do per\u00edodo de teste"
    },
    "data_fim_trial": {
      "type": "string",
      "format": "date-time",
      "description": "Data de fim do per\u00edodo de teste"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "ID do cliente no Stripe"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "ID da assinatura no Stripe"
    }
  },
  "required": [
    "nome",
    "tipo_organizacao",
    "endereco"
  ]
}